DB_HOST=localhost
DB_PORT=5432
DB_USER=verifai_app
DB_PASSWORD=verifai_app_local
DB_NAME=verifai

JWT_SECRET=replace-me-with-32-or-more-character-secret
JWT_TTL=12h

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PROJECT_SECRET_KEY=replace-me-32-byte-base64

CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PAGES=50
# Per-step Playwright operation timeout (ms).
CRAWLER_TIMEOUT_MS=60000
# Hard cap for the whole crawl run (ms). When exceeded, the child is killed
# and the run is marked failed (with partial graph if any pages flushed).
CRAWLER_MAX_DURATION_MS=300000

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
